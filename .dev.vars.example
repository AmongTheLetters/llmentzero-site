# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
# Cloudflare's documented Turnstile TEST keys (always pass); see developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=
IP_HASH_KEY=dev-only-not-secret
PAYHIP_API_KEY=dev-payhip-key
# Prints codes to the terminal instead of emailing them. Refused on llmentzero.com.
EMAIL_MODE=log
